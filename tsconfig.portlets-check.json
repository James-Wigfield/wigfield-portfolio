{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "allowImportingTsExtensions": true,
    "isolatedModules": true,
    "esModuleInterop": true,
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "types": ["react", "react-dom", "three"]
  },
  "include": [
    "src/portara-test/components/portlets/**/*.ts",
    "src/portara-test/components/workers.tsx",
    "src/portara-test/components/hero-3d.tsx",
    "src/portara-test/components/layout-tool.tsx"
  ]
}
