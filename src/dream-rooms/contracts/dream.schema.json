{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "dream.schema.json",
  "title": "dream.json v1: what the dream was (the interpretation)",
  "description": "Every entity quotes his exact words. src spans are filled by tools/dream-rooms/quote-spans.mjs. See src/dream-rooms/CONTRACTS.md section 3.",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "title", "mood", "places", "motifs"],
  "properties": {
    "version": { "const": 1 },
    "title": { "type": "string", "minLength": 1, "maxLength": 80 },
    "mood": {
      "type": "object",
      "additionalProperties": false,
      "required": ["felt", "intensity", "valence"],
      "properties": {
        "felt": { "type": "array", "maxItems": 8, "items": { "type": "string", "minLength": 1, "maxLength": 40 } },
        "intensity": { "type": "number", "minimum": 0, "maximum": 1 },
        "valence": { "type": "number", "minimum": -1, "maximum": 1 },
        "quote": { "$ref": "#/$defs/quotes" },
        "src": { "$ref": "#/$defs/spans" }
      }
    },
    "time": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "said", "quote"],
      "properties": {
        "id": { "const": "time" },
        "said": { "$ref": "#/$defs/words" },
        "contradiction": { "type": "boolean" },
        "quote": { "$ref": "#/$defs/quotes" },
        "src": { "$ref": "#/$defs/spans" }
      }
    },
    "places": { "type": "array", "maxItems": 16, "items": { "$ref": "#/$defs/place" } },
    "links": { "type": "array", "maxItems": 24, "items": { "$ref": "#/$defs/link" } },
    "figures": { "type": "array", "maxItems": 16, "items": { "$ref": "#/$defs/figure" } },
    "objects": { "type": "array", "maxItems": 32, "items": { "$ref": "#/$defs/object" } },
    "changes": { "type": "array", "maxItems": 16, "items": { "$ref": "#/$defs/change" } },
    "vague": { "type": "array", "maxItems": 16, "items": { "$ref": "#/$defs/vague" } },
    "sound": { "type": "array", "maxItems": 8, "items": { "$ref": "#/$defs/sound" } },
    "fragments": {
      "type": "array",
      "maxItems": 24,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["text", "at"],
        "properties": {
          "text": { "type": "string", "minLength": 2, "maxLength": 200 },
          "at": { "type": "string", "pattern": "^(p[0-9]+|wake)$" },
          "src": { "$ref": "#/$defs/span" }
        }
      }
    },
    "motifs": {
      "type": "array",
      "maxItems": 24,
      "uniqueItems": true,
      "items": { "type": "string", "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$", "maxLength": 40 }
    }
  },
  "$defs": {
    "quotes": { "type": "array", "minItems": 1, "maxItems": 8, "items": { "type": "string", "minLength": 2, "maxLength": 400 } },
    "span": { "type": "array", "minItems": 2, "maxItems": 2, "items": { "type": "integer", "minimum": 0 } },
    "spans": { "type": "array", "maxItems": 8, "items": { "$ref": "#/$defs/span" } },
    "words": { "type": "array", "minItems": 1, "maxItems": 8, "items": { "type": "string", "minLength": 1, "maxLength": 120 } },
    "certainty": { "type": "number", "minimum": 0, "maximum": 1 },
    "place": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "is", "archetype", "quote"],
      "properties": {
        "id": { "type": "string", "pattern": "^p[0-9]+$" },
        "is": { "$ref": "#/$defs/words" },
        "archetype": { "enum": ["corridor", "room", "hall", "pool", "other"] },
        "certainty": { "$ref": "#/$defs/certainty" },
        "scale": { "type": "number", "minimum": 0.3, "maximum": 3 },
        "endless": { "type": "boolean" },
        "features": { "type": "array", "maxItems": 12, "items": { "type": "string", "minLength": 1, "maxLength": 120 } },
        "rule": { "type": "string", "minLength": 1, "maxLength": 120 },
        "real": { "type": "string", "minLength": 1, "maxLength": 120 },
        "quote": { "$ref": "#/$defs/quotes" },
        "src": { "$ref": "#/$defs/spans" }
      }
    },
    "link": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "from", "to", "via", "impossible", "quote"],
      "properties": {
        "id": { "type": "string", "pattern": "^l[0-9]+$" },
        "from": { "type": "string", "pattern": "^p[0-9]+$" },
        "to": { "type": "string", "pattern": "^p[0-9]+$" },
        "via": { "type": "string", "minLength": 1, "maxLength": 40 },
        "impossible": { "enum": ["loops-back", "wrong-place", "bigger-inside", "transforms", "two-at-once", "none"] },
        "quote": { "$ref": "#/$defs/quotes" },
        "src": { "$ref": "#/$defs/spans" }
      }
    },
    "figure": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "who", "presence", "quote"],
      "properties": {
        "id": { "type": "string", "pattern": "^f[0-9]+$" },
        "who": { "type": "string", "minLength": 1, "maxLength": 120 },
        "certainty": { "$ref": "#/$defs/certainty" },
        "presence": { "enum": ["glimpse", "voice-only", "always-far", "felt"] },
        "at": { "type": ["string", "null"], "pattern": "^p[0-9]+$" },
        "quote": { "$ref": "#/$defs/quotes" },
        "src": { "$ref": "#/$defs/spans" }
      }
    },
    "object": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "what", "quote"],
      "properties": {
        "id": { "type": "string", "pattern": "^o[0-9]+$" },
        "what": { "type": "string", "minLength": 1, "maxLength": 120 },
        "at": { "type": ["string", "null"], "pattern": "^p[0-9]+$" },
        "salience": { "type": "number", "minimum": 0, "maximum": 1 },
        "quote": { "$ref": "#/$defs/quotes" },
        "src": { "$ref": "#/$defs/spans" }
      }
    },
    "change": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "target", "to", "trigger", "quote"],
      "properties": {
        "id": { "type": "string", "pattern": "^c[0-9]+$" },
        "target": { "type": "string", "pattern": "^([plfocvs][0-9]+|time)$" },
        "to": { "type": "string", "minLength": 1, "maxLength": 120 },
        "trigger": { "enum": ["look-away", "return", "approach", "time"] },
        "quote": { "$ref": "#/$defs/quotes" },
        "src": { "$ref": "#/$defs/spans" }
      }
    },
    "vague": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "what", "quote"],
      "properties": {
        "id": { "type": "string", "pattern": "^v[0-9]+$" },
        "what": { "type": "string", "minLength": 1, "maxLength": 120 },
        "quote": { "$ref": "#/$defs/quotes" },
        "src": { "$ref": "#/$defs/spans" }
      }
    },
    "sound": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "what", "quote"],
      "properties": {
        "id": { "type": "string", "pattern": "^s[0-9]+$" },
        "what": { "type": "string", "minLength": 1, "maxLength": 120 },
        "quote": { "$ref": "#/$defs/quotes" },
        "src": { "$ref": "#/$defs/spans" }
      }
    }
  }
}
